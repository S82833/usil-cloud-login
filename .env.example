# Copia este archivo como .env y reemplaza los valores. El .env NUNCA se sube a GitHub.
POSTGRES_DB=usuarios_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=cambia-esta-clave
# Mínimo 32 caracteres aleatorios (por ejemplo: openssl rand -base64 48)
SESSION_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
DOCKERHUB_USER=tu-usuario-de-docker-hub
